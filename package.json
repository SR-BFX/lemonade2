{
  "name": "lemonade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "autopilot": "tsx scripts/autopilot.ts",
    "db:reset": "prisma db push --force-reset --accept-data-loss && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
